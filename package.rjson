{
  name: js-path-resolver
  version: 1.0.14
  main: dist/index.js
  description: 'Resolves paths in Javascript objects, and provides tools to get, set, replace, or remove the resolved item'
  keywords: [
    path
    dotprop
    dotpath
    javascript
    object
    field
    array
    resolve
  ]
  author: 'TwelveTone LLC'
  homepage: 'https://www.twelvetone.tv/docs/developer-tools/npm-modules/js-path-resolver'
  dependencies: {
  }
  runkitExampleFilename: demo/index.js
  devDependencies: {
    babel-core: ^6.26.0
    babel-loader: ^7.1.5
    babel-plugin-webpack-alias: ^2.1.2
    babel-preset-env: ^1.7.0
    chai: ^4.1.2
    mocha: ^5.1.1
    webpack: ^4.17.1
    webpack-cli: ^2.1.5
  }
  scripts: {
    build: webpack
    dev: webpack-dev-server
    test: 'NODE_ENV=test mocha --require babel-register test/spec/**/*.js'
  }
}